# Copy to .env for local runs. On Netlify, set the same keys under
# Site configuration -> Environment variables. Never commit .env.

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key: stays on the server (Netlify Function), never sent to the browser.
SUPABASE_SERVICE_KEY=

# --- Akidha OMS ---
# Which Akidha to use: PROD or STAGE. Change this one line to switch.
AKIDHA_ENV=STAGE

AKIDHA_BASE_URL_PROD=https://api.akidha.in
AKIDHA_EMAIL_PROD=
AKIDHA_PASSWORD_PROD=

AKIDHA_BASE_URL_STAGE=https://stageapi.akidha.in
AKIDHA_EMAIL_STAGE=
AKIDHA_PASSWORD_STAGE=

# --- Dashboard ---
# Shared password the dashboard asks for before it shows or changes anything.
DASHBOARD_PASSWORD=change-me
PORT=8888
