# Copy to .env for local runs. On Netlify, set the same keys under
# Site configuration -> Environment variables. Never commit .env.

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key: stays on the server (Netlify Function), never sent to the browser.
SUPABASE_SERVICE_KEY=
# Column on Order_Level_V4 that records the last status pushed to Akidha.
# Leave empty to skip writing back to Supabase.
SUPABASE_WRITEBACK_COLUMN=akidha_status

# --- Akidha OMS ---
AKIDHA_BASE_URL=https://YOUR-AKIDHA-HOST
AKIDHA_USERNAME=
AKIDHA_PASSWORD=
# Login endpoint that returns a JSESSIONID cookie.
AKIDHA_LOGIN_PATH=/login
# "form" (application/x-www-form-urlencoded) or "json"
AKIDHA_LOGIN_FORMAT=form
# Status endpoint; {ulid} is replaced with the order's ULID.
AKIDHA_STATUS_PATH=/api/orders/{ulid}/status
AKIDHA_STATUS_METHOD=POST

# --- Dashboard ---
# Shared password the dashboard asks for before it shows or changes anything.
DASHBOARD_PASSWORD=change-me
PORT=8888
