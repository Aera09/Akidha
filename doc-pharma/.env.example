# Copy to .env for local runs. On Netlify, set the same keys under
# Site configuration -> Environment variables. Never commit .env.

# --- Supabase (same project as the HL/Viable dashboard) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# --- DocPharma Partner API ---
# Which DocPharma to use: DEV or PROD. Change this one line to switch.
DOCPHARMA_ENV=DEV

DOCPHARMA_BASE_URL_DEV=https://partner-api.dev.docpharma.in
DOCPHARMA_API_KEY_DEV=

DOCPHARMA_BASE_URL_PROD=https://partner-api.docpharma.in
DOCPHARMA_API_KEY_PROD=

# Always SDD_NDD (same/next day). Other values: HL, COURIER, BATCH.
DOCPHARMA_ORDER_TYPE_DEV=SDD_NDD
DOCPHARMA_ORDER_TYPE_PROD=SDD_NDD

# Status updates. Orders are placed with webhook_url =
#   SUPABASE_URL/functions/v1/docpharma-webhook?token=DOCPHARMA_WEBHOOK_SECRET
# (the Supabase Edge Function in supabase/functions/docpharma-webhook).
# Any long random text; set the same value as an Edge Function secret.
DOCPHARMA_WEBHOOK_SECRET=

# Optional vendor/store code.
DOCPHARMA_VENDOR_CODE=

# --- Dashboard ---
DASHBOARD_PASSWORD=change-me
PORT=8889
