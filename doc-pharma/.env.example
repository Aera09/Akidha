# Copy to .env for local runs. On Netlify, set the same keys under
# Site configuration -> Environment variables. Never commit .env.

# --- Supabase (same project as the HL/Viable dashboard) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# --- DocPharma Partner API ---
# Which DocPharma to use: DEV or PROD. Change this one line to switch.
DOCPHARMA_ENV=DEV

DOCPHARMA_BASE_URL_DEV=https://partner-api.dev.docpharma.in
DOCPHARMA_API_KEY_DEV=

DOCPHARMA_BASE_URL_PROD=https://partner-api.docpharma.in
DOCPHARMA_API_KEY_PROD=

# HL (hyperlocal ~2hr), SDD_NDD (same/next day), COURIER (pan-India) or BATCH
DOCPHARMA_ORDER_TYPE_DEV=HL
DOCPHARMA_ORDER_TYPE_PROD=HL

# Status updates (webhook). DocPharma posts to
#   DOCPHARMA_PUBLIC_URL/api/docpharma-webhook?token=DOCPHARMA_WEBHOOK_SECRET
# DOCPHARMA_PUBLIC_URL is this dashboard's public address (the Netlify site URL;
# localhost won't work because DocPharma can't reach your computer).
# DOCPHARMA_WEBHOOK_SECRET is any long random text you choose.
DOCPHARMA_PUBLIC_URL=
DOCPHARMA_WEBHOOK_SECRET=

# Optional vendor/store code.
DOCPHARMA_VENDOR_CODE=

# --- Dashboard ---
DASHBOARD_PASSWORD=change-me
PORT=8889
